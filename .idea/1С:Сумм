Как работает:
При запуске программы сначала пользователь вводит два числа.
Программа проверяет, являются ли введенные значения корректными.
После проверки выводит сумму чисел.

Процедура ЗапросСуммы()
    // Объявляем переменные для хранения чисел и их суммы
    Число1 = ВводЧисла("Введите первое число: ");
    Число2 = ВводЧисла("Введите второе число: ");
    
    // Вычисляем сумму двух чисел
    Сумма = Число1 + Число2;
    
    // Выводим результат
    Сообщить("Сумма двух чисел: " + Сумма);
КонецПроцедуры

Функция ВводЧисла(Сообщение)
    // Функция для ввода числа от пользователя
    Переменная = 0;
    Попытка
        // Используем диалоговое окно для ввода числа
        Переменная = Строка(Ввод(Сообщение));
        // Проверка на число
        Если Не Число(Переменная) Тогда
            Сообщить("Ошибка: введено не число. Попробуйте снова.");
            Возврат ВводЧисла(Сообщение); // Повторяем ввод
        КонецЕсли;
    Исключение
        Сообщить("Ошибка: произошла ошибка ввода. Попробуйте еще раз.");
    КонецПопытки;
    
    Возврат Число(Переменная); // Возвращаем введенное число
КонецФункции
